# Public browser configuration. These VITE_ values are embedded in the client bundle.
VITE_APP_URL=http://localhost:5173
# Deployed backend origin for the native iOS build; no /api path.
# Set this in the environment building the iOS assets, then rebuild and sync Capacitor.
# Vercel-only changes do not update an installed iOS app. The website uses same-origin /api.
VITE_API_ORIGIN=https://arkcards.com
VITE_SITE_NAME=ArkanaDeck
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Server-only configuration. Never expose these values with a VITE_ prefix.
APPLE_TEAM_ID=VJ7CUG9RR8
APPLE_KEY_ID=replace-with-current-apple-key-id
# Paste the Apple .p8 PEM contents here; escaped \n is supported.
APPLE_PRIVATE_KEY=replace-with-pkcs8-private-key
APPLE_IOS_CLIENT_ID=com.arkcards.app
APPLE_WEB_CLIENT_ID=replace-with-apple-services-id
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_TAROT_WEBHOOK_SECRET=whsec_replace_me
PAYPAL_CLIENT_ID=replace-with-paypal-client-id
PAYPAL_CLIENT_SECRET=replace-with-paypal-client-secret
PAYPAL_ENV=sandbox
PAYPAL_PARTNER_MERCHANT_ID=replace-with-paypal-partner-attribution-id
CRON_SECRET=replace-with-a-long-random-secret

# Optional transactional email notifications.
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=ArkanaDeck <orders@example.com>

# Legacy fee settings for historical payment flows. New standard listings publish for free.
LISTING_AUTHENTICATION_FEE_PENCE=44
LISTING_BUNDLE_FEE_PENCE=66
LISTING_FREE_ALLOWANCE=3

# Optional payment-processing fee settings, in percent and GBP respectively.
STRIPE_PROCESSING_FEE_PERCENT=0
STRIPE_PROCESSING_FEE_FIXED=0
PAYPAL_PROCESSING_FEE_PERCENT=0
PAYPAL_PROCESSING_FEE_FIXED=0
