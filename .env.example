# Public browser configuration. These VITE_ values are embedded in the client bundle.
VITE_APP_URL=http://localhost:5173
VITE_SITE_NAME=ArkanaDeck
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
VITE_PAYPAL_ENABLED=false

# Server-only configuration. Never expose these values with a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_TAROT_WEBHOOK_SECRET=whsec_replace_me
PAYPAL_CLIENT_ID=replace-with-paypal-client-id
PAYPAL_CLIENT_SECRET=replace-with-paypal-client-secret
PAYPAL_ENV=sandbox
PAYPAL_PARTNER_MERCHANT_ID=replace-with-paypal-partner-attribution-id
CRON_SECRET=replace-with-a-long-random-secret

# Optional multi-modal vision authentication provider for tarot deck listings.
VISION_AI_ENDPOINT=replace-with-vision-provider-endpoint
VISION_AI_API_KEY=replace-with-vision-provider-api-key
OPENAI_API_KEY=sk-replace-me

# Optional transactional email notifications.
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=ArkanaDeck <orders@example.com>

# Listing fee model: sale-listing authentication fee, bundle fee, and free-listing allowance (all in pence).
LISTING_AUTHENTICATION_FEE_PENCE=44
LISTING_BUNDLE_FEE_PENCE=66
LISTING_FREE_ALLOWANCE=3

# Optional payment-processing fee settings, in percent and GBP respectively.
STRIPE_PROCESSING_FEE_PERCENT=0
STRIPE_PROCESSING_FEE_FIXED=0
PAYPAL_PROCESSING_FEE_PERCENT=0
PAYPAL_PROCESSING_FEE_FIXED=0
