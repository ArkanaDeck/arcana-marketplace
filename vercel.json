{
  "version": 2,
  "devCommand": "node ./node_modules/vite/bin/vite.js --port $PORT",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https://*.supabase.co; frame-src https://checkout.stripe.com https://www.paypal.com https://www.sandbox.paypal.com"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/checkout-success",
      "destination": "/api/create-order-checkout?checkout_success=1"
    },
    {
      "source": "/api/connect/stripe-onboarding",
      "destination": "/api/create-connect-onboarding"
    },
    {
      "source": "/api/connect/paypal-onboarding",
      "destination": "/api/create-connect-onboarding?action=paypal"
    },
    {
      "source": "/api/connect-status",
      "destination": "/api/create-connect-onboarding?action=status"
    },
    {
      "source": "/api/checkout/paypal/create-order",
      "destination": "/api/create-paypal-order"
    },
    {
      "source": "/api/checkout/paypal/capture-order",
      "destination": "/api/capture-paypal-order?marketplace=1"
    },
    {
      "source": "/api/create-checkout-session",
      "destination": "/api/create-order-checkout?retired=1"
    },
    {
      "source": "/api/create-subscription-checkout",
      "destination": "/api/billing?product=seller-subscription"
    },
    {
      "source": "/api/create-listing-fee-checkout",
      "destination": "/api/billing?product=listing-fee"
    },
    {
      "source": "/api/rent-website-link",
      "destination": "/api/billing?product=website-link"
    },
    {
      "source": "/api/listings/rent-link",
      "destination": "/api/billing?product=listing-external-link"
    },
    {
      "source": "/api/dispatch-order",
      "destination": "/api/order-actions?action=dispatch"
    },
    {
      "source": "/api/mark-order-delivered",
      "destination": "/api/order-actions?action=mark-delivered"
    },
    {
      "source": "/api/confirm-order-received",
      "destination": "/api/order-actions?action=confirm-received"
    },
    {
      "source": "/api/report-order-problem",
      "destination": "/api/order-actions?action=report-problem"
    },
    {
      "source": "/api/tarot-batch-status",
      "destination": "/api/tarot?action=status"
    },
    {
      "source": "/api/submit-tarot-listing-batch",
      "destination": "/api/tarot?action=submit-batch"
    },
    {
      "source": "/api/authenticate-tarot-deck-vision",
      "destination": "/api/tarot?action=authenticate-vision"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/release-expired-payouts",
      "schedule": "0 9 * * *"
    }
  ]
}