{
  "version": 2,
  "routes": [
    {
      "src": "^/api/checkout/paypal/create-order$",
      "dest": "/api/create-paypal-order"
    },
    {
      "src": "^/api/checkout/paypal/capture-order$",
      "dest": "/api/capture-paypal-order?marketplace=1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/api/create-checkout-session$",
      "dest": "/api/create-order-checkout?retired=1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/release-expired-payouts",
      "schedule": "0 9 * * *"
    }
  ]
}