{
  "name": "arkana-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@11.21.0",
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": "11.x"
  },
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "vercel:build": "npx --yes --package=npm@11.21.0 -c 'env -u npm_config_allow_scripts -u NPM_CONFIG_ALLOW_SCRIPTS node node_modules/vercel/dist/vc.js build'",
    "deploy": "npx --yes --package=npm@11.21.0 -c 'env -u npm_config_allow_scripts -u NPM_CONFIG_ALLOW_SCRIPTS node node_modules/vercel/dist/vc.js --prod'",
    "test": "node --test server/checkout.test.js server/lib/tarot-webhook-handler.test.js server/lib/listing-fee-engine.test.js server/lib/listing-status.test.js server/lib/app-store-transaction.test.js server/lib/listing-moderation.test.js server/lib/apple-revocation.test.js && node ./node_modules/vitest/vitest.mjs run src/production-checklist.test.ts src/main-layout.tsx server/lib/tarot-handler.test.js server/lib/storekit-fulfillment.test.ts server/lib/account-deletion.test.ts",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "cap": "node ./node_modules/@capacitor/cli/bin/capacitor",
    "cap:sync:ios": "node ./node_modules/@capacitor/cli/bin/capacitor sync ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@react-email/components": "^1.0.12",
    "@supabase/supabase-js": "^2.112.4",
    "openai": "^7.15.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.2",
    "stripe": "^22.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "jsonwebtoken": "^9.0.3",
    "typescript": "^5.6.3",
    "vercel": "^62.2.0",
    "vite": "^8.3.2",
    "vite-plugin-sitemap": "^0.8.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "tar": "7.5.22",
    "undici@5": "6.29.0",
    "@fastify/busboy": "3.2.2",
    "path-to-regexp@6": "6.3.0",
    "path-to-regexp@8": "8.4.2",
    "minimatch@10": "10.2.6",
    "js-yaml@4": "4.3.2",
    "smol-toml": "1.9.0",
    "vercel": {
      "ts-morph": "28.0.0"
    }
  },
  "allowScripts": {
    "esbuild@0.27.0": true,
    "fsevents@2.3.3": true
  }
}